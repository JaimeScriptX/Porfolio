---
import type { Skills } from "../types";
import Layout from "../layouts/Layout.astro";
import DevLogo from "../components/DevLogo.astro";

const tags: Skills[] = [
  "PHP",
  "Symfony",
  "Vue",
  "Nuxt",
  "JavaScript",
  "TypeScript",
  "Docker",
  "MySQL",
  "Tailwind CSS",
  "Figma",
  "Astro",
];

// Fetch stars count from GitHub
---

<Layout
  documentTitle="Sobre mí"
  documentDescription="Conoce más sobre mi experiencia como desarrollador Full Stack especializado en PHP/Symfony y Vue/Nuxt."
>
  <section class="container">
    <h1 class="main-heading text-swipe-animation" id="greeting">Sobre mí</h1>

    <div class="intro">
      <p>
        👋 ¡Hola! Soy Jaime García Campuzano, desarrollador Full Stack con más
        de tres años de experiencia, especializado en backend con PHP/Symfony y
        frontend con Vue/Nuxt.
      </p>
    </div>
    <section
      class="flex flex-col md:flex-row gap-8 justify-center items-center pt-4"
    >
      <div
        class="[&>p]:mb-4 [&>p>strong]:text-yellow-400 [&>p>strong]:font-semibold text-pretty order-2 md:order-1"
      >
        <p>
          He liderado técnicamente la construcción de una infraestructura de
          microservicios para una empresa del sector transporte a nivel
          nacional, tomando decisiones de arquitectura, integraciones con
          proveedores externos y flujos de pago con QR. También desarrollé el
          microservicio de tienda de una plataforma universitaria con más de
          1.000 alumnos.
        </p>

        <p>
          Me gusta el código limpio, las buenas prácticas y dormir tranquilo:
          tests automatizados en flujos críticos, arquitectura pensada para
          durar y documentación que se entienda. Busco equipos de producto donde
          pueda seguir creciendo como profesional.
        </p>

        <div class="tags flex gap-5">
          {tags.map((tag) => <DevLogo icon={tag} size={30} />)}
        </div>
      </div>
      <img src="/images/profile.png" class="image" />
    </section>
    <section class="heading">
      <h1 class="sub-heading text-swipe-animation">Experiencia laboral</h1>
      <hr />
    </section>
    <section id="cd-timeline" class="cd-container">
      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-picture"></div>

        <div class="cd-timeline-content">
          <h2>💼 Zapp Studio</h2>
          <div class="timeline-content-info">
            <span class="timeline-content-info-title">
              🏢 Desarrollador Full Stack Mid
            </span>
            <span class="timeline-content-info-date">
              📅 Marzo 2025 - Noviembre 2026
            </span>
          </div>
          <p>
            Lideré técnicamente un proyecto de microservicios para un cliente
            del sector transporte: rotación diaria de gasolineras con backups y
            prioridad, integraciones con proveedores de combustible y sistemas
            internos, y flujo de pago con QR. También desarrollé el
            microservicio de tienda de una plataforma universitaria para más de
            1.000 alumnos, con tests automatizados en los flujos críticos.
          </p>
          <ul class="content-skills">
            <li>PHP</li>
            <li>Symfony</li>
            <li>Vue</li>
            <li>Nuxt</li>
            <li>Docker</li>
            <li>MySQL</li>
            <li>PHPUnit</li>
            <li>Doctrine</li>
            <li>GitHub Actions</li>
            <li>Elasticsearch</li>
            <li>Arquitectura hexagonal</li>
          </ul>
        </div>
        <!-- cd-timeline-content -->
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-picture"></div>

        <div class="cd-timeline-content">
          <h2>💼 Compralaentrada</h2>
          <div class="timeline-content-info">
            <span class="timeline-content-info-title">
              🏢 Full Stack Junior
            </span>
            <span class="timeline-content-info-date">
              📅 Febrero 2024 - Marzo 2025
            </span>
          </div>
          <p>
            Desarrollo y mantenimiento de funcionalidades para una plataforma de
            venta de entradas, mejorando componentes reutilizables, flujos de
            usuario y estabilidad de la aplicación. Incorporé pruebas sobre
            recorridos críticos de compra, reduciendo incidencias recurrentes de
            regresión aproximadamente un 25%.
          </p>
          <ul class="content-skills">
            <li>PHP</li>
            <li>Symfony</li>
            <li>JavaScript</li>
            <li>Vue</li>
            <li>MySQL</li>
            <li>Docker</li>
            <li>PHPUnit</li>
          </ul>
        </div>
        <!-- cd-timeline-content -->
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-picture"></div>

        <div class="cd-timeline-content">
          <h2>💼 DIGIO Soluciones Digitales</h2>
          <div class="timeline-content-info">
            <span class="timeline-content-info-title">
              🏢 Full Stack Junior
            </span>
            <span class="timeline-content-info-date">
              📅 Marzo 2023 - Enero 2024
            </span>
          </div>
          <p>
            Desarrollo de funcionalidades y resolución de incidencias en
            proyectos de e-commerce y gestión interna, colaborando con el equipo
            de diseño para implementar interfaces y soluciones a medida.
          </p>
          <ul class="content-skills">
            <li>React</li>
            <li>JavaScript</li>
            <li>TypeScript</li>
            <li>PHP</li>
            <li>NestJS</li>
            <li>Node.js</li>
            <li>Magento</li>
            <li>Docker</li>
            <li>MongoDB</li>
            <li>Jest</li>
          </ul>
        </div>
        <!-- cd-timeline-content -->
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-movie"></div>
        <!-- cd-timeline-img -->

        <div class="cd-timeline-content">
          <h2>Grado superior Desarrollo de Aplicaciones Web</h2>
          <p>
            Graduado en Desarrollo de Aplicaciones Web con enfoque principal en
            JavaScript, PHP, Angular y Symfony.
          </p>
        </div>
        <!-- cd-timeline-content -->
        <span class="cd-date">Oct 2021 | Jun 2023</span>
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-picture"></div>

        <div class="cd-timeline-content">
          <h2>💼 JGH Logística</h2>
          <div class="timeline-content-info">
            <span class="timeline-content-info-title">
              🏢 Auxiliar administrativo
            </span>
            <span class="timeline-content-info-date">
              📅 Jun 2022 - Ago 2022
            </span>
          </div>
          <p>
            Soporte técnico y mantenimiento informático durante el periodo de
            prácticas.
          </p>
          <ul class="content-skills">
            <li>Mantenimiento informático</li>
            <li>Servicio de soporte técnico</li>
          </ul>
        </div>
        <!-- cd-timeline-content -->
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-picture"></div>

        <div class="cd-timeline-content">
          <h2>💼 Brand You Development</h2>
          <div class="timeline-content-info">
            <span class="timeline-content-info-title">
              🏢 Diseñador web
            </span>
            <span class="timeline-content-info-date">
              📅 Abr 2021 - Jun 2021
            </span>
          </div>
          <p>
            Erasmus en el que diseñé y maqueteé sitios web con WordPress y
            Elementor.
          </p>
          <ul class="content-skills">
            <li>Diseño web</li>
            <li>WordPress</li>
            <li>Elementor</li>
            <li>HTML5</li>
            <li>CSS</li>
          </ul>
        </div>
        <!-- cd-timeline-content -->
      </div>
      <!-- cd-timeline-block -->

      <div class="cd-timeline-block">
        <div class="cd-timeline-img cd-movie"></div>
        <!-- cd-timeline-img -->

        <div class="cd-timeline-content">
          <h2>Grado medio Técnico en Sistemas Microinformáticos y Redes</h2>
          <p>
            Graduado en Técnico en Sistemas Microinformáticos y Redes, con
            habilidades en mantenimiento y gestión de sistemas informáticos.
          </p>
        </div>
        <!-- cd-timeline-content -->
        <span class="cd-date">Oct 2019 | Jun 2021</span>
      </div>
      <!-- cd-timeline-block -->
    </section>
  </section>

  <style lang="scss">
    .image {
      border-radius: 155px;
    }

    .cd-container {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding: 0;
    }
    .cd-container::after {
      content: "";
      display: table;
      clear: both;
    }

    #cd-timeline {
      position: relative;
      padding: 2rem 0;
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
    #cd-timeline::before {
      content: "";
      position: absolute;
      top: 0;
      left: 26px;
      height: 100%;
      width: 2px;
      background: linear-gradient(
        to bottom,
        rgba(168, 242, 56, 0.25),
        rgba(168, 242, 56, 0.6),
        rgba(168, 242, 56, 0.25)
      );
      border-radius: 2px;
    }
    @media only screen and (min-width: 1170px) {
      #cd-timeline {
        margin-top: 3rem;
        margin-bottom: 3rem;
      }
      #cd-timeline::before {
        left: 50%;
        margin-left: -1px;
      }
    }

    .cd-timeline-block {
      position: relative;
      margin: 2.5rem 0;
    }
    .cd-timeline-block:after {
      content: "";
      display: table;
      clear: both;
    }
    .cd-timeline-block:first-child {
      margin-top: 0;
    }
    .cd-timeline-block:last-child {
      margin-bottom: 0;
    }
    @media only screen and (min-width: 1170px) {
      .cd-timeline-block {
        margin: 3.5rem 0;
      }
    }

    .cd-timeline-img {
      position: absolute;
      top: 18px;
      left: 20px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #13151a;
      border: 2px solid var(--color-green);
      box-shadow: 0 0 12px rgba(168, 242, 56, 0.35);
      z-index: 2;
    }
    @media only screen and (min-width: 1170px) {
      .cd-timeline-img {
        left: 50%;
        margin-left: -7px;
        top: 26px;
      }
    }

    .cd-timeline-content {
      position: relative;
      margin-left: 60px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow:
        0 4px 24px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
      transition: transform 0.25s ease, box-shadow 0.25s ease,
        border-color 0.25s ease;
    }
    .cd-timeline-content:hover {
      transform: translateY(-3px);
      border-color: rgba(168, 242, 56, 0.25);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.25),
        0 0 20px rgba(168, 242, 56, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }
    .cd-timeline-content:after {
      content: "";
      display: table;
      clear: both;
    }
    .cd-timeline-content h2 {
      color: var(--color-silver-100);
      font-size: var(--font-size-xl);
      font-weight: 600;
      margin-top: 0;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .cd-timeline-content p {
      color: var(--color-silver-200);
      font-size: var(--font-size-base);
      margin: 0.75rem 0;
      line-height: 1.65;
    }
    .cd-date {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--color-green);
      font-family: var(--font-family-IBM-Plex-Mono);
      font-size: var(--font-size-xs);
      background: rgba(168, 242, 56, 0.08);
      border: 1px solid rgba(168, 242, 56, 0.25);
      border-radius: 999rem;
      padding: 0.35rem 0.75rem;
      margin-top: 0.75rem;
      opacity: 0.9;
      transition: all 0.2s ease;
    }
    .cd-date:hover {
      background: rgba(168, 242, 56, 0.15);
      border-color: rgba(168, 242, 56, 0.4);
    }

    .timeline-content-info {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      margin-bottom: 0.75rem;
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 10px;
      font-family: var(--font-family-IBM-Plex-Mono);
      font-size: var(--font-size-xs);
      color: var(--color-silver-300);
    }
    .timeline-content-info-title,
    .timeline-content-info-date {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    @media (max-width: 500px) {
      .timeline-content-info {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
      }
    }

    .content-skills {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
      margin: 1rem 0 0 0;
    }
    .content-skills li {
      font-family: var(--font-family-IBM-Plex-Mono);
      font-size: var(--font-size-xs);
      color: var(--color-silver-200);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 999rem;
      padding: 0.35rem 0.75rem;
      transition: all 0.2s ease;
    }
    .content-skills li:hover {
      border-color: rgba(168, 242, 56, 0.4);
      color: var(--color-green);
      background: rgba(168, 242, 56, 0.08);
    }

    .cd-timeline-content::before {
      content: "";
      position: absolute;
      top: 20px;
      right: 100%;
      height: 0;
      width: 0;
      border: 8px solid transparent;
      border-right: 8px solid rgba(255, 255, 255, 0.08);
    }

    @media only screen and (min-width: 768px) {
      .cd-timeline-content {
        padding: 1.5rem 2rem;
      }
      .cd-timeline-content h2 {
        font-size: var(--font-size-2xl);
      }
      .cd-timeline-content p {
        font-size: var(--font-size-lg);
      }
    }

    @media only screen and (min-width: 1170px) {
      .cd-timeline-content {
        margin-left: 0;
        width: 44%;
      }
      .cd-timeline-content::before {
        top: 28px;
        left: 100%;
        border-color: transparent;
        border-left-color: rgba(255, 255, 255, 0.08);
        border-right-color: transparent;
      }
      .cd-date {
        position: absolute;
        top: 24px;
        left: calc(50% + 1.25rem);
        transform: none;
        margin-top: 0;
        white-space: nowrap;
      }
      .cd-timeline-block:nth-child(even) .cd-timeline-content {
        float: right;
      }
      .cd-timeline-block:nth-child(even) .cd-timeline-content::before {
        top: 28px;
        left: auto;
        right: 100%;
        border-color: transparent;
        border-right-color: rgba(255, 255, 255, 0.08);
        border-left-color: transparent;
      }
      .cd-timeline-block:nth-child(even) .cd-date {
        left: auto;
        right: calc(50% + 1.25rem);
      }
    }
  </style>
</Layout>